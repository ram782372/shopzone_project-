# Server port (optional; defaults to 3000). For smoke tests, override with a free port, e.g. PORT=3010.
PORT=3000
# Google Gemini API key. REQUIRED for LLM answer generation.
# Without it the server boots and retrieval still works, but answers are assembled from retrieved context only.
GOOGLE_API_KEY=
# Optional: override the Gemini model name (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
